{
  "name": "excalidraw-desktop",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://excalidraw.com",
  "author": "Excalidraw contributors",
  "description": "Electron shell for Excalidraw (Linux desktop builds)",
  "main": "electron/main.cjs",
  "scripts": {
    "electron:dev": "concurrently -k \"yarn --cwd ../excalidraw-app vite --host 127.0.0.1 --port 3000 --open false\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:pack": "yarn --cwd ../excalidraw-app build:desktop && electron-builder --linux dir",
    "electron:dist": "yarn --cwd ../excalidraw-app build:desktop && electron-builder --linux"
  },
  "build": {
    "appId": "com.excalidraw.desktop",
    "productName": "Excalidraw",
    "copyright": "Copyright © Excalidraw contributors",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*.cjs",
      "package.json",
      {
        "from": "../excalidraw-app/build",
        "to": "renderer",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "linux": {
      "executableName": "excalidraw",
      "target": ["AppImage", "deb"],
      "category": "Graphics",
      "maintainer": "Excalidraw contributors",
      "icon": "../public/android-chrome-512x512.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "wait-on": "8.0.1"
  }
}
